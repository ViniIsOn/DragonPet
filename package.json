{
  "name": "dragonpet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DragonPet - um jogo original de cuidar de dragões fofos",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:build": "npm run build && cap sync android && gradlew --project-dir android assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "6.2.4",
    "@capacitor/core": "6.2.4",
    "@capacitor/local-notifications": "6.1.3",
    "@capacitor/preferences": "6.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.4",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  },
  "engines": {
    "node": ">=18"
  }
}
